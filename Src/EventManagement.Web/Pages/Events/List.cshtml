@page
@model EventManagement.Web.Pages.Events.ListModel
@{
    ViewData["Title"] = "Events";
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="h2 mb-0">
                    <i class="fas fa-calendar-alt me-2"></i>
                    Events
                </h1>
                <p class="mb-0 mt-2 opacity-75">Discover and manage exciting events</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-page="/Events/Create" class="btn btn-light btn-custom">
                    <i class="fas fa-plus me-2"></i>Create Event
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.IsError && !string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @Model.Message
        </div>
    }

    <!-- Search and Filters -->
    <div class="card card-custom mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="searchTerm" class="form-label">
                        <i class="fas fa-search me-1"></i>Search Events
                    </label>
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="Search by title or description...">
                </div>
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label">
                        <i class="fas fa-filter me-1"></i>Status
                    </label>
                    <select class="form-select" id="statusFilter" name="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="0" selected="@(Model.StatusFilter == EventStatus.Draft)">Draft</option>
                        <option value="1" selected="@(Model.StatusFilter == EventStatus.Published)">Published</option>
                        <option value="2" selected="@(Model.StatusFilter == EventStatus.Cancelled)">Cancelled</option>
                        <option value="3" selected="@(Model.StatusFilter == EventStatus.Completed)">Completed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showMyEventsOnly" 
                               name="showMyEventsOnly" value="true" checked="@Model.ShowMyEventsOnly">
                        <label class="form-check-label" for="showMyEventsOnly">
                            My Events Only
                        </label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-custom">
                            <i class="fas fa-search me-1"></i>Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Events Grid -->
    @if (Model.EventList.Events.Any())
    {
        <div class="row" id="eventsContainer">
            @foreach (var eventItem in Model.EventList.Events)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card card-custom h-100">
                        <div class="card-header border-0 pb-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="status-badge bg-@GetStatusColor(eventItem.Status) text-white">
                                    @GetStatusText(eventItem.Status)
                                </span>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" 
                                            data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-page="/Events/Details" asp-route-id="@eventItem.Id">
                                                <i class="fas fa-eye me-2"></i>View Details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Events/Edit" asp-route-id="@eventItem.Id">
                                                <i class="fas fa-edit me-2"></i>Edit
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-danger" type="button" 
                                                    onclick="confirmDelete('@eventItem.Id', '@eventItem.Title')">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Title</h5>
                            <p class="card-text text-muted">
                                @if (!string.IsNullOrEmpty(eventItem.Description))
                                {
                                    @(eventItem.Description.Length > 100 ? eventItem.Description.Substring(0, 100) + "..." : eventItem.Description)
                                }
                                else
                                {
                                    <em>No description available</em>
                                }
                            </p>
                            <div class="text-muted small mb-3">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fas fa-calendar me-1"></i>
                                        @eventItem.StartDate.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="col-6">
                                        <i class="fas fa-clock me-1"></i>
                                        @eventItem.StartDate.ToString("HH:mm")
                                        @if (eventItem.StartDate != eventItem.EndDate)
                                        {
                                            <span> - @eventItem.EndDate.ToString("HH:mm")</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(eventItem.VenueName))
                                {
                                    <div class="mt-1">
                                        <i class="fas fa-map-marker-alt me-1"></i>
                                        @eventItem.VenueName
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer border-0 bg-transparent pt-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    Created @eventItem.CreatedAt.ToString("MMM dd")
                                </small>
                                <div>
                                    <a asp-page="/Events/Details" asp-route-id="@eventItem.Id" 
                                       class="btn btn-sm btn-outline-primary btn-custom">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!Model.IsError)
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-calendar-times fa-4x text-muted"></i>
            </div>
            <h4 class="text-muted">No Events Found</h4>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.ShowMyEventsOnly)
                {
                    <text>No events match your current filters. Try adjusting your search criteria.</text>
                }
                else
                {
                    <text>There are no events available at the moment.</text>
                }
            </p>
            <a asp-page="/Events/Create" class="btn btn-primary btn-custom">
                <i class="fas fa-plus me-2"></i>Create Your First Event
            </a>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the event "<strong id="eventTitle"></strong>"?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" style="display: inline;">
                    <input type="hidden" id="deleteEventId" name="id" value="">
                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete Event
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(EventStatus status)
    {
        return status switch
        {
            EventStatus.Draft => "secondary",
            EventStatus.Published => "success",
            EventStatus.Cancelled => "danger",
            EventStatus.Completed => "info",
            _ => "secondary"
        };
    }

    private string GetStatusText(EventStatus status)
    {
        return status switch
        {
            EventStatus.Draft => "Draft",
            EventStatus.Published => "Published",
            EventStatus.Cancelled => "Cancelled",
            EventStatus.Completed => "Completed",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        function confirmDelete(eventId, eventTitle) {
            document.getElementById('eventTitle').textContent = eventTitle;
            document.getElementById('deleteEventId').value = eventId;
            
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Function to refresh events (called by SignalR)
        function refreshEvents() {
            window.location.reload();
        }

        // Auto-submit form on filter changes
        document.getElementById('statusFilter').addEventListener('change', function() {
            this.form.submit();
        });

        document.getElementById('showMyEventsOnly').addEventListener('change', function() {
            this.form.submit();
        });

        // Real-time search with debounce
        let searchTimeout;
        document.getElementById('searchTerm').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                this.form.submit();
            }, 500);
        });
    </script>
}