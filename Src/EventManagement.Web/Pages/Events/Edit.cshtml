@page "{id:guid}/edit"
@model EventManagement.Web.Pages.Events.EditModel
@{
    ViewData["Title"] = "Edit Event Details";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/Events">Events</a></li>
        <li class="breadcrumb-item"><a href="/Events/@Model.Event.Id">@Model.Event.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit Details</li>
    </ol>
</nav>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-edit me-2"></i>Edit Event Details</h4>
                </div>
                <div class="card-body">
                    <!-- TempData Messages Display -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Critical Changes Warning -->
                    @if (Model.Event.Status == EventManagement.Web.Models.EventStatus.Published)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Warning:</strong> This event is currently published. Changing critical details like dates or venue may affect existing attendees.
                        </div>
                    }

                    <!-- Update Form -->
                    <form method="post" id="updateEventForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UpdateEventModel.Id" />
                        
                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="UpdateEventModel.Title" class="form-label">
                                        <i class="fas fa-tag me-1"></i>Event Title <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="UpdateEventModel.Title" class="form-control" placeholder="Enter event title" maxlength="200" />
                                    <div class="form-text">
                                        <span id="titleCounter">0</span> / 200 characters
                                    </div>
                                    <span asp-validation-for="UpdateEventModel.Title" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="UpdateEventModel.Description" class="form-label">
                                        <i class="fas fa-align-left me-1"></i>Description
                                    </label>
                                    <textarea asp-for="UpdateEventModel.Description" class="form-control" rows="4" placeholder="Describe your event..." maxlength="1000"></textarea>
                                    <div class="form-text">
                                        <span id="descriptionCounter">0</span> / 1,000 characters
                                    </div>
                                    <span asp-validation-for="UpdateEventModel.Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UpdateEventModel.VenueId" class="form-label">
                                        <i class="fas fa-map-marker-alt me-1"></i>Venue <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="UpdateEventModel.VenueId" class="form-control">
                                        <option value="">Select a venue...</option>
                                        @foreach (var venue in Model.Venues)
                                        {
                                            <option value="@venue.Id">@venue.Name - @venue.Address</option>
                                        }
                                    </select>
                                    <span asp-validation-for="UpdateEventModel.VenueId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <!-- Force Update Checkbox for Published Events -->
                                @if (Model.Event.Status == EventManagement.Web.Models.EventStatus.Published)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Update Options</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" asp-for="UpdateEventModel.ForceUpdate" id="forceUpdate">
                                            <label class="form-check-label" for="forceUpdate">
                                                <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                                                Force update critical changes
                                            </label>
                                            <div class="form-text">
                                                Check this box to allow date/venue changes for published events with existing bookings.
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UpdateEventModel.StartDate" class="form-label">
                                        <i class="fas fa-calendar-alt me-1"></i>Start Date & Time <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="UpdateEventModel.StartDate" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="UpdateEventModel.StartDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UpdateEventModel.EndDate" class="form-label">
                                        <i class="fas fa-calendar-check me-1"></i>End Date & Time <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="UpdateEventModel.EndDate" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="UpdateEventModel.EndDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <hr>
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="/Events/@Model.Event.Id" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Cancel
                                </a>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-primary" id="updateBtn">
                                    <i class="fas fa-save me-2"></i>Update Event Details
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Event Summary Sidebar -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h6><i class="fas fa-info-circle me-2"></i>Current Event Details</h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">
                            @if (Model.Event.Status == EventManagement.Web.Models.EventStatus.Draft)
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                            else if (Model.Event.Status == EventManagement.Web.Models.EventStatus.Published)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else if (Model.Event.Status == EventManagement.Web.Models.EventStatus.Cancelled)
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Completed</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Visibility:</dt>
                        <dd class="col-sm-7">
                            @if (Model.Event.Visibility == EventManagement.Web.Models.EventVisibility.Public)
                            {
                                <span class="badge bg-success">Public</span>
                            }
                            else if (Model.Event.Visibility == EventManagement.Web.Models.EventVisibility.Private)
                            {
                                <span class="badge bg-warning">Private</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Invite Only</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Created:</dt>
                        <dd class="col-sm-7">@Model.Event.CreatedAt.ToString("MMM dd, yyyy")</dd>

                        @if (Model.Event.UpdatedAt.HasValue)
                        {
                            <dt class="col-sm-5">Last Updated:</dt>
                            <dd class="col-sm-7">@Model.Event.UpdatedAt.Value.ToString("MMM dd, yyyy")</dd>
                        }

                        @if (Model.Event.TotalCapacity.HasValue)
                        {
                            <dt class="col-sm-5">Capacity:</dt>
                            <dd class="col-sm-7">@Model.Event.TotalCapacity.Value attendees</dd>
                        }
                    </dl>

                    <div class="alert alert-light">
                        <small class="text-muted">
                            <i class="fas fa-lightbulb me-1"></i>
                            <strong>Tip:</strong> Changes to published events will notify existing attendees about significant updates.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript for form enhancements -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Character counters
    const titleInput = document.getElementById('UpdateEventModel_Title');
    const descriptionInput = document.getElementById('UpdateEventModel_Description');
    const titleCounter = document.getElementById('titleCounter');
    const descriptionCounter = document.getElementById('descriptionCounter');

    function updateCounter(input, counter) {
        const length = input.value.length;
        counter.textContent = length;
        
        // Color coding based on usage
        if (length > input.maxLength * 0.9) {
            counter.className = 'text-danger';
        } else if (length > input.maxLength * 0.7) {
            counter.className = 'text-warning';
        } else {
            counter.className = 'text-success';
        }
    }

    if (titleInput && titleCounter) {
        updateCounter(titleInput, titleCounter);
        titleInput.addEventListener('input', () => updateCounter(titleInput, titleCounter));
    }

    if (descriptionInput && descriptionCounter) {
        updateCounter(descriptionInput, descriptionCounter);
        descriptionInput.addEventListener('input', () => updateCounter(descriptionInput, descriptionCounter));
    }

    // Date validation
    const startDateInput = document.getElementById('UpdateEventModel_StartDate');
    const endDateInput = document.getElementById('UpdateEventModel_EndDate');

    function validateDates() {
        if (startDateInput.value && endDateInput.value) {
            const startDate = new Date(startDateInput.value);
            const endDate = new Date(endDateInput.value);
            
            if (endDate <= startDate) {
                endDateInput.setCustomValidity('End date must be after start date');
            } else {
                endDateInput.setCustomValidity('');
            }
        }
    }

    if (startDateInput && endDateInput) {
        startDateInput.addEventListener('change', validateDates);
        endDateInput.addEventListener('change', validateDates);
    }

    // Form submission with loading state
    const form = document.getElementById('updateEventForm');
    const updateBtn = document.getElementById('updateBtn');

    if (form && updateBtn) {
        form.addEventListener('submit', function() {
            updateBtn.disabled = true;
            updateBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Updating...';
        });
    }
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}