@page
@model EventManagement.Web.Pages.Account.Manage.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.Input.ProfilePictureUrl))
                        {
                            <img src="@Model.Input.ProfilePictureUrl" alt="Profile Picture" class="rounded-circle" width="100" height="100" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto" style="width: 100px; height: 100px; font-size: 2rem;">
                                @Model.Input.FirstName?.First()@Model.Input.LastName?.First()
                            </div>
                        }
                    </div>
                    <h5>@Model.Input.FirstName @Model.Input.LastName</h5>
                    <p class="text-muted">@Model.Input.Email</p>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <nav class="nav flex-column">
                        <a class="nav-link active" asp-page="./Profile">
                            <i class="fas fa-user me-2"></i>Profile
                        </a>
                        <a class="nav-link" asp-page="./ChangePassword">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                    </nav>
                </div>
            </div>
        </div>
        
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>Profile Information
                    </h4>
                </div>
                <div class="card-body">
                    <form id="profile-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        @if (TempData["StatusMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["StatusMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FirstName" class="form-label">First Name</label>
                                    <input asp-for="Input.FirstName" class="form-control" />
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LastName" class="form-label">Last Name</label>
                                    <input asp-for="Input.LastName" class="form-control" />
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" readonly />
                            <small class="form-text text-muted">Email cannot be changed.</small>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.Organization" class="form-label">Organization</label>
                                    <input asp-for="Input.Organization" class="form-control" />
                                    <span asp-validation-for="Input.Organization" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.Department" class="form-label">Department</label>
                                    <input asp-for="Input.Department" class="form-control" />
                                    <span asp-validation-for="Input.Department" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.PreferredLanguage" class="form-label">Preferred Language</label>
                                    <select asp-for="Input.PreferredLanguage" class="form-control">
                                        <option value="en-US">English (US)</option>
                                        <option value="en-GB">English (UK)</option>
                                        <option value="es-ES">Spanish</option>
                                        <option value="fr-FR">French</option>
                                        <option value="de-DE">German</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.TimeZone" class="form-label">Time Zone</label>
                                    <select asp-for="Input.TimeZone" class="form-control">
                                        <option value="UTC">UTC</option>
                                        <option value="America/New_York">Eastern Time</option>
                                        <option value="America/Chicago">Central Time</option>
                                        <option value="America/Denver">Mountain Time</option>
                                        <option value="America/Los_Angeles">Pacific Time</option>
                                        <option value="Europe/London">London</option>
                                        <option value="Europe/Paris">Paris</option>
                                        <option value="Europe/Berlin">Berlin</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Input.ProfilePictureUrl" class="form-label">Profile Picture URL</label>
                            <input asp-for="Input.ProfilePictureUrl" class="form-control" placeholder="https://example.com/profile-picture.jpg" />
                            <span asp-validation-for="Input.ProfilePictureUrl" class="text-danger"></span>
                            <small class="form-text text-muted">Enter a URL for your profile picture.</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button id="update-profile-button" type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Update Profile
                            </button>
                            <a asp-page="/Index" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}