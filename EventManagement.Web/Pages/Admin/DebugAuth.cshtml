@page
@model EventManagement.Web.Pages.Admin.DebugAuthModel
@{
    ViewData["Title"] = "Debug Authentication";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Authentication Debug Info</h3>
                </div>
                <div class="card-body">
                    <h5>Current User (Web App)</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr><td><strong>Is Authenticated:</strong></td><td><span class="badge badge-@(User.Identity?.IsAuthenticated == true ? "success" : "danger")">@(User.Identity?.IsAuthenticated == true ? "Yes" : "No")</span></td></tr>
                                <tr><td><strong>Username:</strong></td><td>@User.Identity?.Name</td></tr>
                                <tr><td><strong>Email:</strong></td><td>@User.FindFirst("email")?.Value</td></tr>
                                <tr><td><strong>User ID:</strong></td><td>@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</td></tr>
                                <tr><td><strong>Roles:</strong></td><td>@string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>All Claims:</h6>
                            <small>
                                @foreach (var claim in User.Claims)
                                {
                                    <div><strong>@claim.Type:</strong> @claim.Value</div>
                                }
                            </small>
                        </div>
                    </div>

                    <hr />

                    <h5>API Debug Info</h5>
                    @if (Model.ApiDebugInfo != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-sm">
                                    <tr><td><strong>API Authenticated:</strong></td><td><span class="badge badge-@(Model.ApiDebugInfo.IsAuthenticated ? "success" : "danger")">@(Model.ApiDebugInfo.IsAuthenticated ? "Yes" : "No")</span></td></tr>
                                    <tr><td><strong>API Email:</strong></td><td>@Model.ApiDebugInfo.Email</td></tr>
                                    <tr><td><strong>API User ID:</strong></td><td>@Model.ApiDebugInfo.UserId</td></tr>
                                    <tr><td><strong>Is Admin:</strong></td><td><span class="badge badge-@(Model.ApiDebugInfo.IsAdmin ? "success" : "danger")">@(Model.ApiDebugInfo.IsAdmin ? "Yes" : "No")</span></td></tr>
                                    <tr><td><strong>API Roles:</strong></td><td>@string.Join(", ", Model.ApiDebugInfo.Roles ?? new List<string>())</td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6>API Claims:</h6>
                                <small>
                                    @if (Model.ApiDebugInfo.AllClaims?.Any() == true)
                                    {
                                        @foreach (var claim in Model.ApiDebugInfo.AllClaims)
                                        {
                                            <div><strong>@claim.Type:</strong> @claim.Value</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted">No claims found</div>
                                    }
                                </small>
                            </div>
                        </div>

                        <hr />

                        <h5>Permission Analysis</h5>
                        <div class="row">
                            <div class="col-md-8">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Can Modify Events Data:</strong></td>
                                        <td><span class="badge badge-@(Model.ApiDebugInfo.CanModifyEventsData ? "success" : "danger")">@(Model.ApiDebugInfo.CanModifyEventsData ? "✅ YES" : "❌ NO")</span></td>
                                    </tr>
                                    @if (Model.ApiDebugInfo.PermissionDetails != null)
                                    {
                                        <tr><td><strong>Has Admin Role:</strong></td><td><span class="badge badge-@(Model.ApiDebugInfo.PermissionDetails.HasAdminRole ? "success" : "danger")">@(Model.ApiDebugInfo.PermissionDetails.HasAdminRole ? "Yes" : "No")</span></td></tr>
                                        <tr><td><strong>Has Events_Modify Claim:</strong></td><td><span class="badge badge-@(Model.ApiDebugInfo.PermissionDetails.HasEventsModifyClaim ? "success" : "danger")">@(Model.ApiDebugInfo.PermissionDetails.HasEventsModifyClaim ? "Yes" : "No")</span></td></tr>
                                        <tr><td><strong>Policy Result:</strong></td><td><span class="badge badge-@(Model.ApiDebugInfo.PermissionDetails.PolicyResult == "Succeeded" ? "success" : "danger")">@Model.ApiDebugInfo.PermissionDetails.PolicyResult</span></td></tr>
                                    }
                                </table>
                            </div>
                            <div class="col-md-4">
                                @if (Model.ApiDebugInfo.PermissionDetails?.Summary != null)
                                {
                                    <div class="alert alert-@(Model.ApiDebugInfo.CanModifyEventsData ? "success" : "warning")">
                                        <strong>Summary:</strong><br />
                                        @Model.ApiDebugInfo.PermissionDetails.Summary
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>Error:</strong> @Model.ApiError
                        </div>
                    }

                    <hr />
                    
                    <h5>Token Info</h5>
                    <table class="table table-sm">
                        <tr><td><strong>Has Token:</strong></td><td><span class="badge badge-@(Model.HasToken ? "success" : "danger")">@(Model.HasToken ? "Yes" : "No")</span></td></tr>
                        <tr><td><strong>Token Length:</strong></td><td>@Model.TokenLength</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>