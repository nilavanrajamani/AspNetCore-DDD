@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">
                    Welcome to Event Management
                </h1>
                <p class="lead mb-4">
                    Create, manage, and discover amazing events with our comprehensive event management platform.
                    From small gatherings to large conferences, we've got you covered.
                </p>
                <div class="d-flex gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Events/Create" class="btn btn-light btn-lg btn-custom">
                            <i class="fas fa-plus me-2"></i>Create Event
                        </a>
                        <a asp-page="/Events/List" class="btn btn-outline-light btn-lg btn-custom">
                            <i class="fas fa-search me-2"></i>Browse Events
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Account/Register" class="btn btn-light btn-lg btn-custom">
                            <i class="fas fa-user-plus me-2"></i>Get Started
                        </a>
                        <a asp-page="/Account/Login" class="btn btn-outline-light btn-lg btn-custom">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <i class="fas fa-calendar-alt" style="font-size: 12rem; opacity: 0.1;"></i>
                    <div class="position-absolute top-50 start-50 translate-middle">
                        <i class="fas fa-users fa-3x text-white"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Features Section -->
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="h3 mb-4">Why Choose Our Platform?</h2>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card card-custom h-100 border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-lightning-bolt fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Fast & Intuitive</h5>
                    <p class="card-text text-muted">
                        Create events in minutes with our streamlined interface. 
                        No complex setup required - just focus on what matters.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card card-custom h-100 border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-bell fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Real-time Updates</h5>
                    <p class="card-text text-muted">
                        Stay connected with instant notifications about your events. 
                        Never miss important updates or changes.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card card-custom h-100 border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-shield-alt fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">Secure & Reliable</h5>
                    <p class="card-text text-muted">
                        Built with enterprise-grade security and reliability. 
                        Your events and data are always safe with us.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="h3">How It Works</h2>
            <p class="text-muted">Get started with event management in three simple steps</p>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                    1
                </div>
                <h5>Create Your Event</h5>
                <p class="text-muted">
                    Add event details, set the date and time, choose your venue, 
                    and configure visibility settings.
                </p>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                    2
                </div>
                <h5>Publish & Promote</h5>
                <p class="text-muted">
                    Publish your event to make it visible to attendees. 
                    Share it across different channels to maximize reach.
                </p>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="text-center">
                <div class="rounded-circle bg-info text-white d-inline-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                    3
                </div>
                <h5>Manage & Monitor</h5>
                <p class="text-muted">
                    Track registrations, send updates, and manage your event 
                    with real-time insights and tools.
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row text-center mb-5">
        <div class="col-12 mb-4">
            <h2 class="h3">Platform Statistics</h2>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card card-custom border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <i class="fas fa-calendar text-primary me-2"></i>
                        <span class="h4 mb-0 fw-bold" id="totalEvents">0</span>
                    </div>
                    <p class="text-muted mb-0">Total Events</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card card-custom border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span class="h4 mb-0 fw-bold" id="publishedEvents">0</span>
                    </div>
                    <p class="text-muted mb-0">Published Events</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card card-custom border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <i class="fas fa-clock text-warning me-2"></i>
                        <span class="h4 mb-0 fw-bold" id="upcomingEvents">0</span>
                    </div>
                    <p class="text-muted mb-0">Upcoming Events</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card card-custom border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <i class="fas fa-map-marker-alt text-info me-2"></i>
                        <span class="h4 mb-0 fw-bold" id="totalVenues">3</span>
                    </div>
                    <p class="text-muted mb-0">Available Venues</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="row">
        <div class="col-12">
            <div class="card card-custom bg-gradient-primary text-white">
                <div class="card-body text-center py-5">
                    <h3 class="mb-3">Ready to Get Started?</h3>
                    <p class="lead mb-4">
                        Join thousands of event organizers who trust our platform 
                        to create memorable experiences.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Events/Create" class="btn btn-light btn-lg btn-custom">
                                <i class="fas fa-plus me-2"></i>Create Your First Event
                            </a>
                            <a asp-page="/Events/List" class="btn btn-outline-light btn-lg btn-custom">
                                <i class="fas fa-list me-2"></i>View All Events
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Account/Register" class="btn btn-light btn-lg btn-custom">
                                <i class="fas fa-user-plus me-2"></i>Join Now
                            </a>
                            <a asp-page="/Account/Login" class="btn btn-outline-light btn-lg btn-custom">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, #8b5cf6 100%);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load and display statistics
            loadEventStatistics();
            
            // Animate numbers
            function animateValue(id, start, end, duration) {
                const obj = document.getElementById(id);
                const range = end - start;
                const increment = end > start ? 1 : -1;
                const stepTime = Math.abs(Math.floor(duration / range));
                let current = start;
                
                const timer = setInterval(() => {
                    current += increment;
                    obj.textContent = current;
                    if (current === end) {
                        clearInterval(timer);
                    }
                }, stepTime);
            }

            async function loadEventStatistics() {
                try {
                    showLoading();
                    
                    // In a real application, this would be an API call
                    // For now, we'll simulate with setTimeout
                    setTimeout(() => {
                        const stats = {
                            total: Math.floor(Math.random() * 50) + 10,
                            published: Math.floor(Math.random() * 30) + 5,
                            upcoming: Math.floor(Math.random() * 20) + 3,
                            venues: 3
                        };
                        
                        // Animate statistics
                        animateValue('totalEvents', 0, stats.total, 1000);
                        animateValue('publishedEvents', 0, stats.published, 1200);
                        animateValue('upcomingEvents', 0, stats.upcoming, 1400);
                        animateValue('totalVenues', 0, stats.venues, 800);
                        
                        hideLoading();
                    }, 500);
                    
                } catch (error) {
                    console.error('Error loading statistics:', error);
                    hideLoading();
                }
            }

            // Add some interactive effects
            $('.card-custom').hover(
                function() { $(this).addClass('shadow-lg'); },
                function() { $(this).removeClass('shadow-lg'); }
            );
        });
    </script>
}del IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
